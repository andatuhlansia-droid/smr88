    .bt-seo-section{
  --bg1:#000000;
  --bg2:#000000;
  --card:#E3F2FF;
  --line:rgba(147 0 0 / 8%);
  --text:#FFFFFF;
  --muted:#cfcfcf;
  --accent1:#c40505;
  --accent2:#2b2b2b;
  --accent3:#169d02;
  --shadow:0 15px 40px rgba(57 54 54 / 35%);
  padding: 60px 20px;
  background:
    radial-gradient(circle at top left, rgba(255,213,74,.10), transparent 30%),
    radial-gradient(circle at bottom right, rgba(0,194,255,.10), transparent 30%),
    linear-gradient(135deg, var(--bg1), var(--bg2));
  color: var(--text);
  font-family: Arial, sans-serif;
}

.bt-container{
  max-width: 1200px;
  margin: 0 auto;
}

.bt-heading{
  text-align:center;
  margin-bottom: 35px;
}

.bt-badge{
  display:inline-block;
  font-size:12px;
  font-weight:700;
  letter-spacing:.08em;
  text-transform:uppercase;
  padding:8px 14px;
  border-radius:5px;
  border: solid var(--line);
  color:#fff;
  background:linear-gradient(135deg, #e4b900, #ffeb00, #efe800);
  margin-bottom:14px;
}

.bt-heading h2{
  margin:0 0 14px;
  font-size:32px;
  line-height:1.25;
  font-weight:800;
}

.bt-heading p{
  max-width:100% !important;
  width:100%;
  margin:0 auto;
  color:var(--muted);
  font-size:15px;
  line-height:1.8;
  text-align:center;
}

.bt-grid{
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap:24px;
}

.bt-box{
  background:rgba(255,255,255,.03);
  border:3px solid var(--line);
  border-radius:22px;
  box-shadow:var(--shadow);
  overflow:hidden;
  backdrop-filter: blur(10px);
}

.bt-box-head{
  padding:24px 24px 10px;
}

.bt-box-head h3{
  margin:0 0 8px;
  font-size:24px;
  font-weight:800;
}

.bt-box-head p{
  margin:0;
  color:var(--muted);
  font-size:14px;
  line-height:1.7;
}

/* FAQ */
.bt-faq-box {
  border-color: rgba(255, 238, 0, 0.22);
  background:
    radial-gradient(ellipse 80% 40% at 50% 0%, rgba(255, 238, 0, 0.08), transparent 55%),
    rgba(255, 255, 255, 0.03);
  position: relative;
}

.bt-faq-box::before {
  content: "";
  position: absolute;
  top: 0;
  left: 24px;
  right: 24px;
  height: 3px;
  border-radius: 0 0 6px 6px;
  background: linear-gradient(90deg, transparent, #ffee00, #c40505, #ffee00, transparent);
  box-shadow: 0 0 16px rgba(255, 238, 0, 0.35);
}

.bt-faq-box .bt-box-head h3 {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #ffee00;
}

.bt-faq-box .bt-box-head h3::before {
  content: "?";
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  font-size: 18px;
  font-weight: 800;
  color: #1a1400;
  border-radius: 12px;
  background: linear-gradient(135deg, #e4b900, #ffeb3b);
  box-shadow: 0 4px 14px rgba(255, 238, 0, 0.25);
  flex-shrink: 0;
}

.bt-faq-list {
  padding: 8px 18px 22px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.bt-faq-item {
  position: relative;
  margin: 0;
  border-radius: 16px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(0, 0, 0, 0.35);
  overflow: hidden;
  transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.25s ease;
}

.bt-faq-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 12px;
  bottom: 12px;
  width: 3px;
  border-radius: 0 4px 4px 0;
  background: transparent;
  transition: background 0.3s ease, box-shadow 0.3s ease;
}

.bt-faq-item:hover {
  border-color: rgba(255, 238, 0, 0.2);
  transform: translateY(-1px);
}

.bt-faq-item.active {
  border-color: rgba(255, 238, 0, 0.4);
  box-shadow:
    0 12px 32px rgba(0, 0, 0, 0.35),
    inset 0 1px 0 rgba(255, 255, 255, 0.04),
    0 0 24px rgba(196, 5, 5, 0.08);
  background: linear-gradient(135deg, rgba(255, 238, 0, 0.05), rgba(0, 0, 0, 0.4));
}

.bt-faq-item.active::before {
  background: linear-gradient(180deg, #ffee00, #c40505);
  box-shadow: 0 0 12px rgba(255, 238, 0, 0.45);
}

.bt-faq-question {
  width: 100%;
  background: none;
  border: none;
  color: var(--text);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  text-align: left;
  padding: 16px 16px 16px 18px;
  font-size: 14px;
  font-weight: 700;
  line-height: 1.45;
  cursor: pointer;
  transition: color 0.2s ease;
}

.bt-faq-item.active .bt-faq-question {
  color: #fff;
}

.bt-faq-qwrap {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  flex: 1;
  min-width: 0;
}

.bt-faq-num {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 28px;
  height: 28px;
  padding: 0 6px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.04em;
  color: rgba(255, 238, 0, 0.95);
  background: rgba(255, 238, 0, 0.1);
  border: 1px solid rgba(255, 238, 0, 0.25);
  border-radius: 8px;
}

.bt-faq-item.active .bt-faq-num {
  color: #1a1400;
  background: linear-gradient(135deg, #e4b900, #ffeb3b);
  border-color: transparent;
}

.bt-faq-qtext {
  flex: 1;
  padding-top: 3px;
}

.bt-faq-question i {
  font-style: normal;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  font-size: 20px;
  font-weight: 700;
  line-height: 1;
  color: #1a1400;
  background: linear-gradient(135deg, #e4b900, #ffeb3b);
  border-radius: 50%;
  box-shadow: 0 4px 12px rgba(255, 238, 0, 0.25);
  transition: transform 0.35s ease, background 0.3s ease, color 0.3s ease;
  flex: 0 0 auto;
}

.bt-faq-item.active .bt-faq-question i {
  transform: rotate(45deg);
  background: linear-gradient(135deg, #c40505, #8b0000);
  color: #fff;
  box-shadow: 0 4px 14px rgba(196, 5, 5, 0.4);
}

.bt-faq-answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.bt-faq-answer p {
  margin: 0;
  padding: 4px 18px 18px 58px;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.85;
  border-top: 1px dashed rgba(255, 255, 255, 0.06);
  padding-top: 14px;
}

.bt-faq-item.active .bt-faq-answer p {
  animation: btFaqIn 0.4s ease;
}

@keyframes btFaqIn {
  from {
    opacity: 0;
    transform: translateY(-6px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Reviews */
.bt-review-box {
  border-color: rgba(255, 238, 0, 0.22);
  background:
    radial-gradient(ellipse 70% 45% at 100% 0%, rgba(196, 5, 5, 0.12), transparent 50%),
    radial-gradient(ellipse 60% 40% at 0% 100%, rgba(255, 238, 0, 0.06), transparent 45%),
    rgba(255, 255, 255, 0.03);
  position: relative;
}

.bt-review-box::before {
  content: "";
  position: absolute;
  top: 0;
